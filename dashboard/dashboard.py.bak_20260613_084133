                rc1.metric("Declaration ID",     f"#{dec_id}")
                rc2.metric("IF Score",           f"{if_score:.4f}")
                rc3.metric("LSTM Score",
                           f"{lstm_score:.4f}"
                           if lstm_score else "N/A")
                rc4.metric("Ensemble Score",     f"{ens:.4f}")

                st.markdown("---")

                if ens >= ENSEMBLE_LEVEL2:
                    st.markdown(f"""
                    <div class="score-high">
                        <h3>🚨 LEVEL 2 ALERT TRIGGERED</h3>
                        <b>Ensemble Score: {ens:.4f}</b>
                        (threshold: {ENSEMBLE_LEVEL2})<br>
                        <b>Predicted Fraud Type:
                            {fraud_type.replace('_',' ').title()}</b><br>
                        Declaration #{dec_id} has been
                        <b>flagged for enforcement review</b>.
                    </div>
                    """, unsafe_allow_html=True)
                    if shap_vals:
                        st.markdown(
                            "**Primary anomaly driver:** "
                            + shap_vals.get("_explanation","")
