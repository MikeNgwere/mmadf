                        <b>Ensemble Score: {ens:.4f}</b>
                        (threshold: {ENSEMBLE_LEVEL1})<br>
                        <b>Predicted Type:
                            {fraud_type.replace('_',' ').title()}</b>
                    </div>
                    """, unsafe_allow_html=True)

                else:
                    st.markdown(f"""
                    <div class="score-low">
                        <h3>✅ CLEAR — No Anomaly Detected</h3>
                        <b>Ensemble Score: {ens:.4f}</b>
                        (below {ENSEMBLE_LEVEL1} threshold)<br>
                        Declaration appears normal.
                    </div>
                    """, unsafe_allow_html=True)

                # Feature breakdown
                with st.expander(
                    "📊 Feature Vector Used for Detection"
                ):
                    feat_df = pd.DataFrame([{
                        "Feature": f,
                        "Value": round(float(v),4)
                    } for f,v in feat_vec.items()])
                    st.dataframe(feat_df,
                                 use_container_width=True,
                                 hide_index=True)

            except Exception as e:
                st.error(f"Error submitting declaration: {e}")

    # ════════════════════════════════════════════════════════
