                        level = 2 if ens >= ENSEMBLE_LEVEL2 else 1
                        execute("""
                            INSERT INTO alerts
                                (dec_id, score_id, alert_level,
                                 fraud_type_predicted,
                                 feature_contribution)
                            VALUES (%s,%s,%s,%s,%s)
                            ON CONFLICT DO NOTHING
                        """, (dec_id, score_id, level,
                              fraud_type,
                              psycopg2.extras.Json(shap_vals)
                              if shap_vals else None))

                        # Flag declaration
                        if level == 2:
                            execute("""
                                UPDATE declarations
                                SET status='flagged'
                                WHERE dec_id=%s
                            """, (dec_id,))

                # ── Show result ────────────────────────────
